        </Sequence>

        <Sequence>
          <DECO_TimeCheck name="FinalLeadTime" UpDown="Greater" Time="170" BB="{BB}"/>
          <DECO_DistanceCheck name="FinalLeadLow" UpDown="Greater" Distance="150" BB="{BB}"/>
          <DECO_DistanceCheck name="FinalLeadHigh" UpDown="Less" Distance="1220" BB="{BB}"/>
          <DECO_LOSCheck name="FinalLeadLOS" UpDown="Less" InputLOS="3.0" BB="{BB}"/>
          <Task_LeadPursuit name="Task_LeadPursuit" LeadTime="0.08" LeadDistance="75" MinAltitude="1150" Throttle="0.98" BB="{BB}"/>
        </Sequence>

        <Sequence>
          <DECO_TimeCheck name="MidLeadStart" UpDown="Greater" Time="100" BB="{BB}"/>
          <DECO_TimeCheck name="MidLeadEnd" UpDown="Less" Time="150" BB="{BB}"/>
          <DECO_DistanceCheck name="MidLeadLow" UpDown="Greater" Distance="915" BB="{BB}"/>
          <DECO_DistanceCheck name="MidLeadHigh" UpDown="Less" Distance="1220" BB="{BB}"/>
          <DECO_LOSCheck name="MidLeadLOS" UpDown="Less" InputLOS="3.0" BB="{BB}"/>
