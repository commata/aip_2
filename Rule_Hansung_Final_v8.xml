<root main_tree_to_execute = "MainTree">

  <BehaviorTree ID="MainTree">
    <Sequence>
      <SelectTarget name="SelectTarget" BB="{BB}"/>
      <DirectionVectorUpdate name="DirectionVectorUpdate" BB="{BB}"/>
      <DistanceUpdate name="DistanceUpdateService" BB="{BB}"/>
      <CheckSight name="CheckSight" BB="{BB}"/>
      <AngleOffUpdate name="AngleOffUpdate" BB="{BB}"/>
      <AspectAngleUpdate name="AspectAngleUpdate" BB="{BB}"/>

      <Fallback>
        <Sequence>
          <DECO_AltitudeCheck name="AltitudeLow" UpDown="Less" Altitude="1300" BB="{BB}"/>
          <Task_AltitudeGuard name="Task_AltitudeGuard" MinAltitude="1300" RecoveryAltitude="2500" ForwardDistance="6000" BB="{BB}"/>
        </Sequence>

        <Sequence>
          <DECO_DistanceCheck name="OvershootRisk" UpDown="Less" Distance="150" BB="{BB}"/>
          <Task_OvershootGuard name="Task_OvershootGuard" LagDistance="650" SideOffset="360" LookAheadTime="0.35" MinAltitude="1150" CloseThrottle="0.64" BB="{BB}"/>
        </Sequence>

        <Sequence>
          <DECO_TimeCheck name="LateCloseGuardTime" UpDown="Greater" Time="150" BB="{BB}"/>
          <DECO_DistanceCheck name="LateCloseGuardRange" UpDown="Less" Distance="305" BB="{BB}"/>
