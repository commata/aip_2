          <DECO_DistanceCheck name="LatePredictLow" UpDown="Greater" Distance="915" BB="{BB}"/>
          <DECO_DistanceCheck name="LatePredictHigh" UpDown="Less" Distance="1220" BB="{BB}"/>
          <DECO_LOSCheck name="LatePredictLOS" UpDown="Less" InputLOS="3.0" BB="{BB}"/>
          <Task_PredictivePursuit name="Task_PredictivePursuit" MinPrediction="0.4" MaxPrediction="1.05" PredictionScale="0.32" MinAltitude="1150" FarThrottle="1.0" BB="{BB}"/>
        </Sequence>

        <Sequence>
          <DECO_TimeCheck name="MidAttackStart" UpDown="Greater" Time="100" BB="{BB}"/>
          <DECO_TimeCheck name="MidAttackEnd" UpDown="Less" Time="150" BB="{BB}"/>
          <DECO_DistanceCheck name="MidRangeLow" UpDown="Greater" Distance="150" BB="{BB}"/>
          <DECO_DistanceCheck name="MidRangeHigh" UpDown="Less" Distance="1067" BB="{BB}"/>
          <DECO_LOSCheck name="MidGoodLOS" UpDown="Less" InputLOS="30" BB="{BB}"/>
          <Task_AggressivePure name="Task_AggressivePure" LeadTime="0.11" MinAltitude="1150" BB="{BB}"/>
          <Task_ThrottleControl name="Task_ThrottleControl" CloseDistance="300" FarDistance="1200" MinAltitude="1300" CloseThrottle="0.80" CruiseThrottle="0.98" FarThrottle="1.0" BB="{BB}"/>
        </Sequence>

        <Sequence>
          <DECO_TimeCheck name="LateCleanShot" UpDown="Greater" Time="150" BB="{BB}"/>
          <DECO_DistanceCheck name="LateGunRangeLow" UpDown="Greater" Distance="150" BB="{BB}"/>
          <DECO_DistanceCheck name="LateGunRangeHigh" UpDown="Less" Distance="1220" BB="{BB}"/>
          <DECO_LOSCheck name="LateCleanLOS" UpDown="Less" InputLOS="16" BB="{BB}"/>
