        </Sequence>

        <Sequence>
          <DECO_TimeCheck name="FinalAttack" UpDown="Greater" Time="170" BB="{BB}"/>
          <DECO_DistanceCheck name="FinalRangeLow" UpDown="Greater" Distance="150" BB="{BB}"/>
          <DECO_DistanceCheck name="FinalRangeHigh" UpDown="Less" Distance="1220" BB="{BB}"/>
          <DECO_LOSCheck name="FinalAttackLOS" UpDown="Less" InputLOS="28" BB="{BB}"/>
          <Task_AggressivePure name="Task_AggressivePure" LeadTime="0.09" MinAltitude="1150" BB="{BB}"/>
          <Task_ThrottleControl name="Task_ThrottleControl" CloseDistance="300" FarDistance="1300" MinAltitude="1300" CloseThrottle="0.82" CruiseThrottle="0.99" FarThrottle="1.0" BB="{BB}"/>
        </Sequence>

        <Sequence>
          <DECO_TimeCheck name="FinalReconnect" UpDown="Greater" Time="170" BB="{BB}"/>
          <DECO_DistanceCheck name="TooFarFinal" UpDown="Greater" Distance="1220" BB="{BB}"/>
          <Task_Reengage name="Task_Reengage" LeadTime="0.13" LeadDistance="140" MinAltitude="1150" Throttle="1.0" BB="{BB}"/>
        </Sequence>

        <Sequence>
          <DECO_TimeCheck name="MidReconnect" UpDown="Greater" Time="35" BB="{BB}"/>
          <DECO_DistanceCheck name="TooFarMid" UpDown="Greater" Distance="1220" BB="{BB}"/>
          <Task_AggressivePure name="Task_AggressivePure" LeadTime="0.13" MinAltitude="1150" BB="{BB}"/>
          <Task_ThrottleControl name="Task_ThrottleControl" CloseDistance="600" FarDistance="1700" MinAltitude="1300" CloseThrottle="0.82" CruiseThrottle="0.98" FarThrottle="1.0" BB="{BB}"/>
        </Sequence>

        <Sequence>
          <DECO_TimeCheck name="LatePhase" UpDown="Greater" Time="35" BB="{BB}"/>
          <DECO_LOSCheck name="WideLOS" UpDown="Greater" InputLOS="35" BB="{BB}"/>
          <Task_LagPursuit name="Task_LagPursuit" LagDistance="780" SideOffset="360" LookAheadTime="0.48" MinAltitude="1150" BB="{BB}"/>
          <Task_ThrottleControl name="Task_ThrottleControl" CloseDistance="900" FarDistance="2800" MinAltitude="1300" CloseThrottle="0.72" CruiseThrottle="0.92" FarThrottle="1.0" BB="{BB}"/>
        </Sequence>

        <Sequence>
          <Task_AggressivePure name="Task_AggressivePure" LeadTime="0.12" MinAltitude="1150" BB="{BB}"/>
          <Task_ThrottleControl name="Task_ThrottleControl" CloseDistance="850" FarDistance="2500" MinAltitude="1300" CloseThrottle="0.80" CruiseThrottle="0.95" FarThrottle="1.0" BB="{BB}"/>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>

</root>
