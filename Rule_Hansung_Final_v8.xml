        </Sequence>

        <Sequence>
          <DECO_TimeCheck name="MergeDefenseStart" UpDown="Greater" Time="18" BB="{BB}"/>
          <DECO_TimeCheck name="MergeDefenseEnd" UpDown="Less" Time="35" BB="{BB}"/>
          <DECO_DistanceCheck name="MergeRange" UpDown="Less" Distance="1220" BB="{BB}"/>
          <DECO_LOSCheck name="NotCleanShot" UpDown="Greater" InputLOS="6" BB="{BB}"/>
          <Task_LagPursuit name="Task_LagPursuit" LagDistance="780" SideOffset="560" LookAheadTime="0.46" MinAltitude="1150" BB="{BB}"/>
          <Task_ThrottleControl name="Task_ThrottleControl" CloseDistance="300" FarDistance="1300" MinAltitude="1300" CloseThrottle="0.72" CruiseThrottle="0.93" FarThrottle="1.0" BB="{BB}"/>
        </Sequence>

        <Sequence>
          <DECO_DistanceCheck name="SnapRangeLow" UpDown="Greater" Distance="150" BB="{BB}"/>
          <DECO_DistanceCheck name="SnapRangeHigh" UpDown="Less" Distance="915" BB="{BB}"/>
          <DECO_LOSCheck name="SnapLOS" UpDown="Less" InputLOS="6" BB="{BB}"/>
          <Task_AggressivePure name="Task_AggressivePure" LeadTime="0.10" MinAltitude="1150" BB="{BB}"/>
          <Task_ThrottleControl name="Task_ThrottleControl" CloseDistance="300" FarDistance="1100" MinAltitude="1300" CloseThrottle="0.80" CruiseThrottle="0.98" FarThrottle="1.0" BB="{BB}"/>
        </Sequence>

        <Sequence>
          <DECO_TimeCheck name="EarlyPhase" UpDown="Less" Time="35" BB="{BB}"/>
          <Task_AggressivePure name="Task_AggressivePure" LeadTime="0.18" MinAltitude="1150" BB="{BB}"/>
          <Task_ThrottleControl name="Task_ThrottleControl" CloseDistance="900" FarDistance="3200" MinAltitude="1300" CloseThrottle="0.8" CruiseThrottle="0.95" FarThrottle="1.0" BB="{BB}"/>
        </Sequence>

        <Sequence>
          <DECO_TimeCheck name="TailWEZTime" UpDown="Greater" Time="150" BB="{BB}"/>
          <DECO_DistanceCheck name="TailWEZLow" UpDown="Greater" Distance="150" BB="{BB}"/>
          <DECO_DistanceCheck name="TailWEZHigh" UpDown="Less" Distance="915" BB="{BB}"/>
          <DECO_LOSCheck name="TailWEZLOS" UpDown="Less" InputLOS="2.0" BB="{BB}"/>
