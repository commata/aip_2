<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence>
      <SelectTarget name="SelectTarget" BB="{BB}"/>
      <DirectionVectorUpdate name="DirectionVectorUpdate" BB="{BB}"/>
      <DistanceUpdate name="DistanceUpdate" BB="{BB}"/>
      <CheckSight name="CheckSight" BB="{BB}"/>
      <AngleOffUpdate name="AngleOffUpdate" BB="{BB}"/>
      <AspectAngleUpdate name="AspectAngleUpdate" BB="{BB}"/>

      <Fallback>
        <Sequence>
          <DECO_AltitudeCheck name="LowAltitude" UpDown="Less" Altitude="1500" BB="{BB}"/>
          <Task_AltitudeGuard
            name="AltitudeGuard"
            RecoveryAltitude="2400"
            ForwardDistance="7000"
            BB="{BB}"/>
        </Sequence>

        <Sequence>
          <DECO_DistanceCheck name="ThreatMinimum" UpDown="Greater" Distance="350" BB="{BB}"/>
          <DECO_DistanceCheck name="ThreatMaximum" UpDown="Less" Distance="1400" BB="{BB}"/>
          <DECO_TargetLOSCheck name="TargetHasGunSolution" UpDown="Less" InputLOS="4" BB="{BB}"/>
          <DECO_LOSCheck name="TargetOutsideMyNose" UpDown="Greater" InputLOS="35" BB="{BB}"/>
          <Task_ThreatBreak
            name="RearThreatBreak"
            Duration="1.10"
            ForwardDistance="1200"
            SideOffset="2400"
            AltitudeOffset="250"
            MinAltitude="1800"
            Throttle="1.0"
            BB="{BB}"/>
        </Sequence>

        <Sequence>
          <DECO_TimeCheck name="ScoreFinishPhase" UpDown="Greater" Time="145" BB="{BB}"/>
          <DECO_ScoreCheck name="TargetWeakForFinish" Mode="TargetHealthLess" Threshold="0.45" BB="{BB}"/>
          <DECO_ScoreCheck name="OwnSafeForFinish" Mode="OwnHealthGreater" Threshold="0.65" BB="{BB}"/>
          <DECO_DistanceCheck name="ScoreFinishMinimum" UpDown="Greater" Distance="260" BB="{BB}"/>
          <DECO_DistanceCheck name="ScoreFinishMaximum" UpDown="Less" Distance="950" BB="{BB}"/>
          <DECO_LOSCheck name="ScoreFinishLOS" UpDown="Less" InputLOS="6" BB="{BB}"/>
          <DECO_TargetLOSCheck name="ScoreFinishNotThreatened" UpDown="Greater" InputLOS="3" BB="{BB}"/>
          <Task_WEZHold
            name="ScoreAwareFinish"
            LeadTime="0.08"
            MinAltitude="1800"
            CloseThrottle="0.80"
            CruiseThrottle="0.97"
            FarThrottle="1.0"
            BB="{BB}"/>
        </Sequence>

        <Sequence>
          <DECO_TimeCheck name="LateFight" UpDown="Greater" Time="100" BB="{BB}"/>
          <DECO_DistanceCheck name="MutualMinimum" UpDown="Greater" Distance="450" BB="{BB}"/>
          <DECO_DistanceCheck name="MutualMaximum" UpDown="Less" Distance="1300" BB="{BB}"/>
          <DECO_LOSCheck name="MyMutualLOS" UpDown="Less" InputLOS="4" BB="{BB}"/>
          <DECO_TargetLOSCheck name="TargetMutualLOS" UpDown="Less" InputLOS="4" BB="{BB}"/>
          <Task_ThreatBreak
            name="MutualGunBreak"
            Duration="0.80"
            ForwardDistance="2200"
            SideOffset="1400"
            AltitudeOffset="200"
            MinAltitude="1800"
            Throttle="1.0"
            BB="{BB}"/>
        </Sequence>

        <Sequence>
          <DECO_DistanceCheck name="OvershootDistance" UpDown="Less" Distance="220" BB="{BB}"/>
          <Task_OvershootGuard
            name="OvershootGuard"
            LagDistance="650"
            SideOffset="350"
            LookAheadTime="0.30"
            MinAltitude="1800"
            Throttle="0.72"
            BB="{BB}"/>
        </Sequence>

        <Sequence>
          <DECO_TimeCheck name="LateEnergyPhase" UpDown="Greater" Time="168" BB="{BB}"/>
          <DECO_DistanceCheck name="LateEnergyDistance" UpDown="Greater" Distance="1900" BB="{BB}"/>
          <Task_EnergyReengage
            name="LateEnergyRecovery"
            ActivationTime="168"
            EntrySpeed="205"
            ExitSpeed="245"
            LeadTime="0.14"
            LeadDistance="180"
            RecoveryAltitudeDrop="450"
            MaxClimbOffset="-250"
            MinAltitude="1500"
            Throttle="1.0"
            FailIfAboveEntry="true"
            ForwardRecovery="3600"
            BB="{BB}"/>
        </Sequence>

        <Sequence>
          <DECO_TimeCheck name="EnergyPhase" UpDown="Greater" Time="145" BB="{BB}"/>
          <DECO_DistanceCheck name="EnergyDistance" UpDown="Greater" Distance="1800" BB="{BB}"/>
          <Task_EnergyReengage
            name="EnergyMidReengage"
            ActivationTime="145"
            EntrySpeed="190"
            ExitSpeed="230"
            LeadTime="0.16"
            LeadDistance="220"
            RecoveryAltitudeDrop="120"
            MaxClimbOffset="0"
            MinAltitude="1500"
            Throttle="1.0"
            FailIfAboveEntry="true"
            ForwardRecovery="0"
            BB="{BB}"/>
        </Sequence>

        <Sequence>
          <DECO_DistanceCheck name="WEZMinimum" UpDown="Greater" Distance="180" BB="{BB}"/>
          <DECO_DistanceCheck name="WEZMaximum" UpDown="Less" Distance="950" BB="{BB}"/>
          <DECO_LOSCheck name="WEZLineOfSight" UpDown="Less" InputLOS="6" BB="{BB}"/>
          <Task_WEZHold
            name="WEZHold"
            LeadTime="0.08"
            MinAltitude="1800"
            CloseThrottle="0.78"
            CruiseThrottle="0.94"
            FarThrottle="1.0"
            BB="{BB}"/>
        </Sequence>

        <Sequence>
          <DECO_DistanceCheck name="ReengageDistance" UpDown="Greater" Distance="1300" BB="{BB}"/>
          <Task_EnergyReengage
            name="EnergyAwareReengage"
            ActivationTime="100"
            EntrySpeed="190"
            ExitSpeed="220"
            LeadTime="0.16"
            LeadDistance="220"
            RecoveryAltitudeDrop="200"
            MaxClimbOffset="300"
            MinAltitude="1800"
            Throttle="1.0"
            FailIfAboveEntry="false"
            ForwardRecovery="0"
            BB="{BB}"/>
        </Sequence>

        <Task_Pursue name="DefaultPursuit" BB="{BB}"/>
      </Fallback>
    </Sequence>
  </BehaviorTree>
</root>


